# Copy to .env and fill in. Every value here is a placeholder.
DOMAIN=example.com
TZ=Europe/Paris
PUID=1000
PGID=1000

# Big data disk (service volumes, models)
DATA_ROOT=/srv/docker-data
# Markdown notes vault (Syncthing, dashboard API)
NOTES_PATH=/srv/notes

CLOUDFLARE_TUNNEL_TOKEN=changeme
VAULTWARDEN_ADMIN_TOKEN=changeme
NEXTCLOUD_DB_ROOT_PASSWORD=changeme
NEXTCLOUD_DB_PASSWORD=changeme
COUCHDB_USER=admin
COUCHDB_PASSWORD=changeme
GITEA_SSH_PORT=2222

MINECRAFT_EULA=false
MINECRAFT_MEMORY=8G
